              "raw": "{{baseUrl}}/api/students/1/events?date=2025-06-15",
              "host": ["{{baseUrl}}"],
              "path": ["api","students","1","events"],
              "query": [{ "key": "date", "value": "2025-06-15" }]
            }
          }
        }
      ]
    },

    {
      "name": "Reports (admin)",
      "item": [
